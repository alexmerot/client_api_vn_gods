# Copy to .env next to docker-compose.yml, one per site, and fill in the values.

# Site identifier, used for the container name (e.g. faune79 -> faune79_vn)
SITE=faune79

# Image to run (built once with `docker build -t client_api:latest .` from the repo root)
IMAGE=client_api:latest

# UID:GID the container runs as, so bind-mounted files keep host-readable ownership
APP_UID=1000
APP_GID=1000

